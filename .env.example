# Server
PORT=3000
PUBLIC_BASE_URL=https://nux-optmize.up.railway.app
NODE_ENV=production
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@host:5432/nux_optmize

# Momence API (Host API, https://api.docs.momence.com)
# client_id/secret: Dashboard -> Profile -> Public API clients
# username/password: um usuario da equipe com acesso ao Host Dashboard
# (criado so para o bot, com permissao de reservar/cancelar)
MOMENCE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENCE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENCE_USERNAME=bot@nuxhouse.com.br
MOMENCE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENCE_API_BASE_URL=https://api.momence.com/api/v2
# Confirmar com o estudio quantas horas antes da aula o cancelamento
# passa a ser "tardio" (ver docs/momence-api-notes.md)
LATE_CANCEL_HOURS=12

# WhatsApp Cloud API (Meta) - developers.facebook.com
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-aleatoria-aqui
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_CLASS_REMINDER=lembrete_aula
# Quanto tempo o bot fica pausado para um aluno depois que alguem da
# equipe responde pelo app WhatsApp Business (modo de coexistencia)
HUMAN_TAKEOVER_MINUTES=120

# Jobs
REMINDER_CHECK_INTERVAL_MINUTES=15
REMINDER_LEAD_TIME_MINUTES=120
SESSION_CACHE_TTL_MINUTES=10
