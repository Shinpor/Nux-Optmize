# Server
PORT=3000
PUBLIC_BASE_URL=https://nux-optmize.up.railway.app
NODE_ENV=production
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@host:5432/nux_optmize

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_BOOKING_CONFIRMATION_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CLASS_REMINDER_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Momence API
# ATENCAO: nomes de variaveis e URLs abaixo sao provisorios.
# Confirme em https://api.docs.momence.com com suas credenciais reais
# e ajuste conforme docs/momence-api-notes.md
MOMENCE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENCE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENCE_API_BASE_URL=https://api.momence.com/api/v2
MOMENCE_OAUTH_TOKEN_URL=https://api.momence.com/oauth/token
MOMENCE_HOST_ID=xxxxxxxxxxx

# Jobs
REMINDER_CHECK_INTERVAL_MINUTES=15
REMINDER_LEAD_TIME_MINUTES=120
SESSION_CACHE_TTL_MINUTES=10
